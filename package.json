{
  "name": "keyringer",
  "version": "2.0.0",
  "description": "Deterministic keypear + HyperDHT trees: derive sibling address/encryption keys from a text path, announce with the private pair, load and decrypt with the public pair",
  "main": "index.js",
  "bin": {
    "keyringer": "cli.js"
  },
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "hyperdht": "^6.33.0",
    "keypear": "^1.2.2"
  },
  "keywords": [
    "keys",
    "cryptography",
    "ed25519",
    "hierarchical",
    "p2p",
    "hyperdht",
    "keypear",
    "holepunch"
  ],
  "author": "lanmower",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanmower/keyringer.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
